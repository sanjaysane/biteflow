# ── Meta WhatsApp Business Cloud API ─────────────────────────────
# Permanent access token from developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAB...your-permanent-token
# Phone number ID from the same API Setup page (NOT the display phone number)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Graph API version pinned for stability
WHATSAPP_API_VERSION=v21.0

# ── Webhook verification ─────────────────────────────────────────
# Any random secret string YOU invent; must match the "Verify token" you
# type into the Meta app dashboard when subscribing the webhook.
WEBHOOK_VERIFY_TOKEN=choose-a-long-random-secret

# ── Database (Supabase Postgres) ─────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI mode).
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres

# ── App ──────────────────────────────────────────────────────────
# Directory containing en.json / es.json / hi.json
LOCALES_DIR=locales
# Default language for brand-new chats
DEFAULT_LANGUAGE=en
# Comma-separated E.164 numbers allowed to register as cooks (optional safety rail)
# COOK_ALLOWLIST=+15550001111,+15550002222
